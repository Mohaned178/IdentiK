# IdentiK production stack — the host secret set for deploy/.env.
#
#   cp .env.example .env && chown root:root .env && chmod 0600 .env
#
# Compose reads this file for interpolation and passes it to the app
# container. It is gitignored, and it is part of backup scope: losing the
# signing keys invalidates every Session and token, silently. Every change
# applies by recreating the affected service:
#   docker compose up -d --force-recreate app

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# One secret, used twice: Postgres initializes with it and compose derives the
# app's DATABASE_URL from it, so the two can never disagree. Generate with:
#   openssl rand -hex 24
# Hex only: an unencoded URL-reserved character would corrupt DATABASE_URL.
POSTGRES_PASSWORD=

# The dedicated subdomain whose A/AAAA record points at the VPS. Compose
# derives IDENTIK_BASE_URL=https://<hostname> and Caddy requests the
# certificate for it. No scheme, no trailing slash.
IDENTIK_HOSTNAME=

# The exact released image tag to run — never a floating tag.
#   ghcr.io/mohaned178/identik:v0.1.0
IDENTIK_IMAGE_TAG=

# A JSON array of JWKs; the first entry is the private signing key and signs.
# Mint one with the image's keygen subcommand and paste the single line:
#   docker run --rm ghcr.io/mohaned178/identik:v0.1.0 keygen
#
# Rotation — publish the new key first, retire the old one last:
#   1. keygen a fresh key and prepend it to the array (new key first).
#   2. Recreate the app so the array reloads.
#   3. Wait out the longest token TTL (refresh default: 30 days).
#   4. Remove the old key and recreate the app again.
# Emergency full replacement is break-glass, not rotation: it invalidates
# every outstanding Session and token at once.
IDENTIK_SIGNING_JWKS=

MAIL_TRANSPORT_BINDING=smtp
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=IdentiK <no-reply@example.com>
# SMTP_USER and SMTP_PASSWORD are required together or not at all.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# The compose bridge subnet from docker-compose.yml: the direct peer is the
# Caddy container. Never "true", never "loopback". Keep the two in lockstep.
IDENTIK_TRUST_PROXY=172.28.0.0/24

# ---------------------------------------------------------------------------
# Banned on the host
# ---------------------------------------------------------------------------

# IDENTIK_BASE_URL and DATABASE_URL are derived by compose.
# IDENTIK_DEV_MODE and IDENTIK_TEST_DATABASE_URL never belong on a live host.
