# IdentiK deployment configuration (documentation, not a loader).
#
# The Instance reads process.env directly; copy these into your service manager,
# container, or shell. Values shown are the local-development examples.

# Required: the PostgreSQL system of record. The schema is created by the
# documented migrate step, never at boot:
#   npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/identik

# Required: the externally reachable base URL of this Instance. It is the base
# for verification, reset, and invitation links.
IDENTIK_BASE_URL=http://localhost:3000

# Optional: the HTTP port the backend listens on. Defaults to 3000.
PORT=3000

# Required: how outbound mail leaves the Instance.
#   capture — in-memory transport with the test-only /dev/mail surface
#   smtp    — deliver through the relay below
MAIL_TRANSPORT_BINDING=capture

# SMTP relay settings, required when MAIL_TRANSPORT_BINDING=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=identik
# SMTP_PASSWORD=change-me
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# Recommended in production: a stable JWKS for signing tokens. When unset the
# Instance generates an ephemeral key and tokens do not survive a restart.
# IDENTIK_SIGNING_JWKS={"keys":[...]}

# Token and session windows, in milliseconds. Defaults are shown.
# IDENTIK_SETUP_TOKEN_TTL_MS=1800000
# IDENTIK_SESSION_TTL_MS=2592000000
# IDENTIK_VERIFICATION_TOKEN_TTL_MS=86400000
# IDENTIK_RESET_TOKEN_TTL_MS=3600000
# IDENTIK_EMAIL_CHANGE_TOKEN_TTL_MS=3600000
# IDENTIK_INVITATION_TOKEN_TTL_MS=604800000
# IDENTIK_AUTHORIZATION_CODE_TTL_MS=60000
# IDENTIK_ACCESS_TOKEN_TTL_MS=300000
# IDENTIK_REFRESH_TOKEN_TTL_MS=2592000000

# Throttle escalation (ADR-0020). Defaults are shown.
# IDENTIK_THROTTLE_WINDOW_MS=900000
# IDENTIK_THROTTLE_AFTER_ATTEMPTS=50
# IDENTIK_THROTTLE_BASE_DELAY_MS=200
# IDENTIK_THROTTLE_MAX_DELAY_MS=5000

# Tests only: the administrative connection the end-to-end harness uses to
# create, clone, and drop an Instance database per test. Defaults to the
# conventional local server below.
# IDENTIK_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
