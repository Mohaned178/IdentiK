# IdentiK deployment configuration (documentation, not a loader).
#
# The Instance reads process.env directly; copy these into your service manager,
# container, or shell. Values shown are the local-development examples.
#
# The Instance is production-strict by default: required settings must be
# present, a present-but-invalid value fails startup, and the development-only
# fallbacks (the captured-mail binding and ephemeral signing keys) are refused
# unless IDENTIK_DEV_MODE=1 is set.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The PostgreSQL system of record. The schema is created by the documented
# migrate step, never at boot:
#   npx prisma migrate deploy
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/identik

# The externally reachable base URL of this Instance. It is the base for
# verification, reset, and invitation links, and it defines the public origin
# (an https URL makes session cookies Secure).
IDENTIK_BASE_URL=http://localhost:3000

# How outbound mail leaves the Instance.
#   smtp    — deliver through the relay below (production)
#   capture — in-memory transport with the development-only /dev/mail surface
MAIL_TRANSPORT_BINDING=smtp

# SMTP relay settings, required when MAIL_TRANSPORT_BINDING=smtp.
# SMTP_USER/SMTP_PASSWORD are required together or not at all.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
MAIL_FROM=IdentiK <no-reply@example.com>
# SMTP_USER=identik
# SMTP_PASSWORD=change-me
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# A stable signing key set — a JSON array of JWKs; the first one is private and
# signs. Required in production: without it, an ephemeral key would invalidate
# every outstanding token on restart. Keep it in your secret manager.
# IDENTIK_SIGNING_JWKS=[{"kty":"RSA","n":"...","e":"AQAB","d":"..."}]

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# The HTTP port the backend listens on. Defaults to 3000.
# PORT=3000

# Token and session windows, in milliseconds. Defaults are shown. A value that
# is present but invalid fails startup; an absent value keeps its default.
# IDENTIK_SETUP_TOKEN_TTL_MS=1800000
# IDENTIK_SESSION_TTL_MS=2592000000
# IDENTIK_VERIFICATION_TOKEN_TTL_MS=86400000
# IDENTIK_RESET_TOKEN_TTL_MS=3600000
# IDENTIK_EMAIL_CHANGE_TOKEN_TTL_MS=3600000
# IDENTIK_INVITATION_TOKEN_TTL_MS=604800000
# IDENTIK_AUTHORIZATION_CODE_TTL_MS=60000
# IDENTIK_ACCESS_TOKEN_TTL_MS=300000
# IDENTIK_REFRESH_TOKEN_TTL_MS=2592000000

# Throttle escalation (ADR-0020). Defaults are shown.
# IDENTIK_THROTTLE_WINDOW_MS=900000
# IDENTIK_THROTTLE_AFTER_ATTEMPTS=50
# IDENTIK_THROTTLE_BASE_DELAY_MS=200
# IDENTIK_THROTTLE_MAX_DELAY_MS=5000

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------

# Permits the captured-mail binding and an ephemeral signing key generated at
# boot. Never set this in production: tokens do not survive a restart and the
# unauthenticated /dev/mail surface is mounted.
# IDENTIK_DEV_MODE=1

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# The administrative connection the end-to-end harness uses to create, clone,
# and drop an Instance database per test. Defaults to the conventional local
# server below.
# IDENTIK_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
