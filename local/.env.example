# Local-only stack values, interpolated by docker compose from this directory.
# Copy to local/.env to override (the file is gitignored). Nothing here is a
# production secret — production values belong in deploy/.env and never here.
#
# The stack runs out of the box with these defaults; change LOCAL_POSTGRES_PASSWORD
# if you want a local password that is not in the repository.

LOCAL_POSTGRES_PASSWORD=identik-local
LOCAL_APP_PORT=3000